# iCloud 照片迁移助手配置文件

# Apple ID（可选）
apple_id: ""

# 存储路径（必填）
nas_path: ""

# Cookie 存储目录
cookie_dir: "./cookies"

# 文件夹格式
folder_format: "%Y/%Y-%m/%Y-%d"

# 下载线程数（1-20，默认 20）
# 增加线程数可以加快下载速度
threads_num: 20

# 仅下载新文件
only_new: true

# 下载照片
download_photos: true

# 下载视频
download_videos: true

# 跳过实况照片
skip_live_photos: false

# 最大重试次数
max_retries: 3

# 日志级别
log_level: "INFO"
